//max_heap

int kthSmallest(const std::vector<int>& nums, int k) {
    std::priority_queue<int> mh;
    for (int i = 0; i < k; i++) {
        mh.push(nums[i]);
    }

    for (int i = k; i < nums.size(); i++) {
        if (nums[i] < mh.top()) {
            mh.pop();
            mh.push(nums[i]);
        }
    }
    return mh.top();
}

//min_heap

int kthSmallest(const std::vector<int>& nums, int k) {
    std::priority_queue<int, std::vector<int>, std::greater<int>> pq;
    for (int i = 0; i < nums.size(); i++) {
        pq.push(nums[i]);
    }

    for (int i = 0; i < k - 1; i++) {
        pq.pop();
    }
    return pq.top();
}
