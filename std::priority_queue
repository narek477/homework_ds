std::vector<Point> kClosest(const std::vector<Point>& points, int k) {

    std::priority_queue<Point> pq;
    for (const Point& point : points) {
        if (pq.size() < k) {
            pq.push(point);
        } else if (point.distance() < pq.top().distance()) {
            pq.pop();
            pq.push(point);
        }
    }

    std::vector<Point> result;
    while (!pq.empty()) {
        result.push_back(pq.top());
        pq.pop();
    }
    return result;
}
