class MedianFinder {

private:
    std::priority_queue<int> pq1;
    std::priority_queue<int, std::vector<int>, std::greater<int> > pq2;

public:
    MedianFinder() {}

    void addNum(int num) {
        pq1.push(num);

        pq2.push(pq1.top());
        pq1.pop();

        if (pq1.size() < pq2.size()) {
            pq1.push(pq2.top());
            pq2.pop();
        }
    }

    double findMedian() {
        if (pq1.size() > pq2.size()) {
            return static_cast<double>(pq1.top());
        } else {
            return (static_cast<double>(pq1.top() + pq2.top())) / 2;
        }
    }
};

