std::vector<int> heapSort(const std::vector<int>& nums) {
    std::priority_queue<int, std::vector<int>, std::greater<int>> pq;

    for (int num : nums) {
        pq.push(num);
    }

    std::vector<int> result;
    while (!pq.empty()) {
        result.push_back(pq.top());
        pq.pop();
    }
    return result;
}

