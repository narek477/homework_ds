#include <iostream>


struct ListNode {

    int data;
    ListNode* next;
    
    explicit ListNode(int val): data(val), next(nullptr) {}
    
};

void printList(ListNode* head) {
    while(head != nullptr) {
        std::cout << head->data << " ";
        head = head->next;
    }
}

int main() {
    
    ListNode* head = new ListNode(1);
    head->next = new ListNode(2);
    head->next->next = new ListNode(3);
    printList(head);
}

