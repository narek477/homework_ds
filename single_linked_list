bool hasCycle(ListNode* head) {
    if (head == nullptr || head->next == nullptr) {
        return false;
    }
    ListNode* tmp1 = head;
    ListNode* tmp2 = head;
    while (tmp2 != nullptr && tmp2->next != nullptr) {
        tmp1 = tmp1->next;
        tmp2 = tmp2->next->next;
        if (tmp1 == tmp2) {
            return true;
        }
    }
    return false;
}


