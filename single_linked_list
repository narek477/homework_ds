    std::cout << std::endl;
}


int binaryToDecimal(ListNode* head) {
    int dec = 0;
    while (head != nullptr) {
        dec = dec * 2 + head->data;
        head = head->next;
    }
    return dec;
}

ListNode* createList() {
    return nullptr;
}

template<typename T, typename... Rest>
ListNode* createList(T first, Rest... rest) {
    ListNode* head = new ListNode(first);
    head->next = createList(rest...);
    return head;
}

ListNode* findMiddle(ListNode* head) {
    int count = 0;
    ListNode* tmp = head;
    while (tmp != nullptr) {
        count++;
        tmp = tmp->next;
    }
    int index = (count / 2);
    while (index != 0 && head != nullptr) {
        head = head->next;
        index--;
    }
    return head;
}

int main() {

    ListNode* head = createList(1, 2, 3, 4, 5);
    ListNode* head2 = createList(1, 2, 3, 4, 5, 6);
    printList(head);
    printList(findMiddle(head));
    printList(findMiddle(head2));
} 

