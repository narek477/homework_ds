int findMin(TreeNode* root) {
    if(root == nullptr) {
        throw std::invalid_argument("No root");
    }
    
    int min = root->data;
    std::queue<TreeNode*> q;
    q.push(root);
    
    while(!q.empty()) {
        TreeNode* curr = q.front();
        q.pop();
        
        min = std::min(min, curr->data);
        if(curr->left != nullptr) {
            q.push(curr->left);
        }
        if(curr->right != nullptr) {
            q.push(curr->right);
        }
    }
    return min;
}

int findMax(TreeNode* root) {
    if(root == nullptr) {
        throw std::invalid_argument("No root");
    }
    
    int max = root->data;
    std::queue<TreeNode*> q;
    q.push(root);
    
    while(!q.empty()) {
        TreeNode* curr = q.front();
        q.pop();
        
        max = std::max(max, curr->data);
        if(curr->left != nullptr) {
            q.push(curr->left);
        }
        if(curr->right != nullptr) {
            q.push(curr->right);
        }
    }
    return max;
    
}

