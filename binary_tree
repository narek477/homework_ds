int  countNodesAtDepth(TreeNode* root, int k) {
    if(root == nullptr) {
        return 0;
    }
    
    if(k == 1) {
        return 1;
    }
    
    return countNodesAtDepth(root->left, k - 1) + countNodesAtDepth(root->right, k - 1);
}

