bool areIdentical(TreeNode* root1, TreeNode* root2) {
    if(root1 == nullptr && root2 == nullptr) {
        return true;
    }
    
    if(root1 == nullptr || root2 == nullptr) {
        return false;
    }
    
   
    return (root1->data == root2->data) && areIdentical(root1->left, root2->left) 
            && areIdentical(root1->right, root2->right);
}

