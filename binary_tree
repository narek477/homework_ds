int sumNodes(TreeNode* root) {
    if (root == nullptr) {
        return 0;
    }
    
    int sum = 0;
    std::queue<TreeNode*> q;
    q.push(root);
    while (!q.empty()) {
        TreeNode* node = q.front();
        q.pop();
        sum += node->data;
        if (node->left != nullptr) {
            q.push(node->left);
        }   
        if (node->right != nullptr) {
            q.push(node->right);
        }
    }
    return sum;
}

