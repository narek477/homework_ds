template<typename T>
void rotateDeque(std::deque<T>& d, int k) {
    if(k > 0) {
        for(int i = 0; i < k; i++) {
            T tmp = d.back();
            d.pop_back();
            d.push_front(tmp);
        }
    } else {
        k = -k;
        for(int i = 0; i < k; i++) {
            T tmp = d.front();
            d.pop_front();
            d.push_back(tmp);
        }
    }
}
