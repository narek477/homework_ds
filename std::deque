void createAndFillDeque(int n) {
    std::deque<int> d;
    for(int i = 1; i <= n; i++) {
        if(i % 2 != 0) {
            d.push_back(i);
        } else {
            d.push_front(i);
        }
    }
    
    for(int i = 0; i < n; i++) {
        std::cout << d[i] << " ";
    }
    
} 

