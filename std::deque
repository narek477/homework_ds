void removeFromBothEnds(std::deque<int>& d, int k) {
    for(int i = 0; i < d.size(); i++) {
        if(d.size() == 0) {
            break;
        }
        
        while(k != 0){
            d.pop_front();
            d.pop_back();
            std::cout << "Current size is " << d.size() << std::endl << "Current elems are ";
            for(int i = 0; i < d.size(); i++) {
                std::cout << d[i] << " ";
            }
            std::cout << std::endl;
            k--;
        }
    }
}

