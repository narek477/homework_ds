template<typename T>
class CircularDeque {

private:
    T* buffer;
    int capacity;
    int size;
    int frontt;
    int rear;


public:

    CircularDeque(): buffer(nullptr), capacity(0), size(0), frontt(0), rear(0) {};

    explicit CircularDeque(int capacity) {
        this->capacity = capacity;
        this->size = 0;
        this->frontt = 0;
        this->rear = 0;
        buffer = new T[capacity];
    }

    ~CircularDeque() {
        delete[] buffer;
    }

    bool isEmpty() const {
        return size == 0;
    }

    int getSize() const {
        return size;
    }

    void resize() {
        int newcapacity = 0;
        if (capacity == 0) {
            newcapacity = 1;
        } else {
            newcapacity = capacity * 2;
        }

        T* newbuffer = new T[newcapacity];
        for (int i = 0; i < size; i++) {
            newbuffer[i] = buffer[(frontt + i) % capacity];
        }

        delete[] buffer;
        buffer = newbuffer;
        capacity = newcapacity;
        rear = size;
        frontt = 0;
    }

    void push_front(const T& value) {
        if (size == capacity) {
            resize();
        }
        frontt = (frontt -1 + capacity) % capacity;
        buffer[frontt] = value;
        size++;
    }

    void push_back(const T& value) {
        if (size == capacity) {
            resize();
        }
        buffer[rear] = value;
        rear = (rear + 1) % capacity;
        size++;
    }

    T pop_front() {
        if (size == 0) {
            return T();
        }
        T value = buffer[frontt];
        frontt = (frontt + 1) % capacity;
        size--;
        return value;
    }

    T pop_back() {
        if (size == 0) {
            return T();
        }
        rear = (rear - 1 + capacity) % capacity;
        T value = buffer[rear];
        size--;
        return value;
    }

    T front() const {
        return buffer[frontt];
    }

    T back() const {
        return buffer[(rear - 1 + capacity) % capacity];
    }

    T& operator[](int index) {
        return buffer[(frontt + index)];
    }

    const T& operator[](int index) const {
        return buffer[(frontt + index)];
    }

};
