std::map<char, std::vector<std::string>> groupByFirstChar(const std::vector<std::string>& vec) {
    std::map<char, std::vector<std::string>> result;
    for (int i = 0; i < vec.size(); i++) {
        const std::string& str = vec[i];
        if (!str.empty()) {
            char ch = str[0];
            result[ch].push_back(str);
        }
    }
    return result;
}

