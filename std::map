int firstUniqueChar(const std::string& s) {
    std::map<char, int> count;

    for (int  i = 0; i < s.length(); i++) {
        count[s[i]]++;
    }

    for (int i = 0; i < s.length(); i++) {
        if (count[s[i]] == 1) {
            return i;
        }
    }
    return -1;
}


