int findMinBST(TreeNode *root) {
    if (root == nullptr) {
        return INT_MIN;
    }
    if (root->left == nullptr) {
        return root->data;
    }
    while (root->left != nullptr) {
        root = root->left;
    }
    return root->data;
}

int findMaxBST(TreeNode* root) {
    if (root == nullptr) {
        return INT_MAX;
    }
    if (root->right == nullptr) {
        return root->data;
    }
    while (root->right != nullptr) {
        root = root->right;
    }
    return root->data;
}

