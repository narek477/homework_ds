int kthSmallest(TreeNode *root, int k) {
    std::stack<TreeNode *> st;
    TreeNode* curr = root;
    int count = 0;

    while (curr != nullptr || !st.empty()) {
        while (curr != nullptr) {
            st.push(curr);
            curr = curr->left;
        }

        curr = st.top();
        st.pop();
        count++;

        if (count == k) {
            return curr->data;
        }

        curr = curr->right;
    }
    return INT_MIN;
}

