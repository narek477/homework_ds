bool isBalanced(const std::string& s) {
    std::stack<char> stack;

    for (int i = 0; i < s.length(); i++) {
        char c = s[i];
        if (c == '(' || c == '{' || c == '[') {
            stack.push(c);
        }
        else if (c == ')' || c == '}' || c == ']') {
            if (stack.empty()) {
                return false;
            }

            char top = stack.top();
            stack.pop();

            if (c == ')' && top != '(') {
                return false;
            }

            if (c == '}' && top != '{') {
                return false;
            }

            if (c == ']' && top != '[') {
                return false;
            }
        }
    }
    return stack.empty();
}

