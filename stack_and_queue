int timeRequiredToBuy(std::vector<int>& tickets, int k) {
    std::queue<std::pair<int, int>> q;
    int seconds = 0;

    for (int i = 0; i < tickets.size(); i++) {
        q.push(std::make_pair(i, tickets[i]));
    }

    while (true) {
        auto p = q.front();
        q.pop();
        p.second--;
        seconds++;

        if (p.second > 0) {
            q.push(p);
        }

        if (p.first == k && p.second == 0) {
            return seconds;
        }
    }
}
