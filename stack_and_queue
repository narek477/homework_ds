std::vector<std::string> generateBinaryNumbers(int n) {
    std::vector<std::string> result;
    std::queue<std::string> q;
    if (n < 0) {
        return result;
    }

    q.push("1");
    for (int i = 0; i < n; i++) {
        std::string number = q.front();
        q.pop();
        result.push_back(number);

        q.push(number + "0");
        q.push(number + "1");
    }
    return result;

}

