void reverseString(std::string& s) {
    std::stack<char> st;
    for (int i = 0; i < s.length(); i++) {
        st.push(s[i]);
    }

    for (int i = 0; i < s.length(); i++) {
        s[i] = st.top();
        st.pop();
    }

}


