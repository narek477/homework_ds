std::string hotPotato(std::vector<std::string>& players, int k) {
    std::queue<std::string> q;
    for (int i = 0; i < players.size(); i++) {
        q.push(players[i]);
    }
    
    for (int i = 0; i < k; i++) {
        std::string s = q.front();
        q.pop();
        q.push(s);
    }
    q.pop();
    return q.front();
}

