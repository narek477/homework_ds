std::vector<int> findIntersection(const std::vector<int>& v1,const std::vector<int>& v2) {
    std::vector<int> result;
    std::set<int> set(v1.begin(),v1.end());

    for (int i = 0; i < v2.size(); i++) {
        if (set.count(v2[i])) {
            result.push_back(v2[i]);
        }
    }
    return result;
}

