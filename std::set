std::vector<int> removeDuplicates(const std::vector<int>& nums) {
    std::set<int> set;
    std::vector<int> result;

    for (int i = 0; i < nums.size(); i++) {
        set.insert(nums[i]);
    }

    for (auto it = set.begin(); it != set.end(); it++) {
        result.push_back(*it);
    }
    return result;
}

