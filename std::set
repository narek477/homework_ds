std::vector<int> findMissingNumbers(std::vector<int> nums, int n) {
    std::vector<int> result;
    std::set<int> set(nums.begin(), nums.end());

    for (int i = 1; i <= n; i++) {
        if (set.count(i) == 0) {
            result.push_back(i);
        }
    }
    return result;
}

