bool isSubset(const std::vector<int>& subset, const std::vector<int>& superset) {
    if (subset.size() > superset.size()) {
        return false;
    }
    std::set<int> set(superset.begin(), superset.end());

    for (int i = 0; i < subset.size(); i++) {
        if (!set.count(subset[i])) {
            return false;
        }
    }
    return true;
}

