int findClosest(const std::set<int>& set, int value) {
    if (set.empty()) {
        return -1;
    }
    auto it = set.lower_bound(value);

    auto prev = std::prev(it);
    if (std::abs(*prev - value) <= std::abs(*it - value)) {
        return *prev;
    }
    return *it;
}

