std::vector<int> symmetricDifference(const std::vector<int>& v1, const std::vector<int>& v2) {
    std::vector<int> result;
    std::set<int> set1(v1.begin(),v1.end());
    std::set<int> set2(v2.begin(), v2.end());

    for (int num : set1) {
        if (set2.count(num) == 0) {
            result.push_back(num);
        }
    }

    for (int num : set2) {
        if (set1.count(num) == 0) {
            result.push_back(num);
        }
    }
    return result;
}

