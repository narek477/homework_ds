bool hasAllCodes(const std::string& str, int k) {
    if (str.length() < k) {
        return false;
    }

    std::set<std::string> set_substr;
    for (int i = 0; i <= str.length() - k; i++) {
        set_substr.insert(str.substr(i, k));
    }
    return set_substr.size() == (1 << k);
}
