int rangeCount(const std::set<int>& set, int low, int high) {
    auto lower = set.lower_bound(low);
    auto upper = set.upper_bound(high);
    int count = 0;

    for (auto it = lower; it != upper; it++) {
        count++;
    }
    return count;
}

