void moveElementsToFront(std::forward_list<int>& list, int value) {
    auto prev = list.before_begin();
    auto curr = list.begin();

    while (curr != list.end()) {
        if (*curr == value) {
            int val = *curr;
            curr = list.erase_after(prev);
            list.insert_after(list.before_begin(), val);
        } else {
            prev = curr;
            ++curr;
        }
    }
}

