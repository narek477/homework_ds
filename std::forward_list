int removeIf(std::forward_list<int>& lst, Func func) {
    int count = 0;
    auto it = lst.begin();
    while (it != lst.end()) {
        if (func(*it)) {
            count++;
        }
        ++it;
    }
    lst.remove_if(func);
    return count;
}

