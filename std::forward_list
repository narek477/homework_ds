bool insertAfterPosition(std::forward_list<int>& list, int position, int value) {
    std::forward_list<int>::iterator it = list.begin();
    for (int i = 0; i < position; i++) {
        it++;
        if (it == list.end()) {
            return false;
        }
    }
    list.insert_after(it, value);
    return true;
}

