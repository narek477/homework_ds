void mergeSortedLists(std::forward_list<int>& l1, std::forward_list<int>& l2) {
    auto it1 = l1.before_begin();
    auto curr = l1.begin();
    auto it2 = l2.begin();

    while (curr != l1.end() && it2 != l2.end()) {
        if (*curr > *it2) {
            l1.insert_after(it1, *it2);
            ++it2;
        } else {
            ++curr;
        }
        ++it1;
    }

    while (it2 != l2.end()) {
        l1.insert_after(it1, *it2);
        ++it1;
        ++it2;
    }
    l2.clear();
}

