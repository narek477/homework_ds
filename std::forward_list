int removeAllOccurences(std::forward_list<int>& lst, const int value) {
    std::forward_list<int>::iterator it1 = lst.before_begin();
    std::forward_list<int>::iterator it2 = lst.begin();
    int count = 0;
    while (it2 != lst.end()) {
        if (*it2 == value) {
            it2 = lst.erase_after(it1);
            count++;
        } else {
            it1 = it2;
            ++it2;
        }
    }
    return count;
}

